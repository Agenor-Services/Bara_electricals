---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import business from '../../data/business.json';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Bara Electrical Servicing",
  "description": "Contact licensed Victorian electrician Nick (REC 29064) for residential, commercial and emergency electrical services across Melbourne's West.",
  "mainEntity": {
    "@id": "https://www.baraelec.com.au/#business"
  }
};
---

<BaseLayout
  title="Contact Us | Bara Electrical Servicing | Melbourne West Electricians"
  metaDescription="Contact Bara Electrical Servicing. Call 0403 669 041 for 24/7 emergency response or request a free quote online. Licensed Victorian Electrician REC 29064."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" }
  ]}
  schema={contactSchema}
>
  <div class="container" style="padding-top: 4rem; padding-bottom: 5rem;">
    <div class="header-block">
      <span class="badge" style="background: rgba(245, 166, 35, 0.1); color: var(--accent); padding: 0.35rem 0.85rem; border-radius: 999px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">24/7 Response Available</span>
      <h1 style="margin-top: 1rem;">Contact Bara Electrical Servicing</h1>
      <p class="lead">
        Need an emergency electrician or planning a switchboard upgrade, EV charger, or home renovation? Contact Nick and our licensed team directly.
      </p>
    </div>

    <div class="contact-grid" style="margin-top: 3.5rem; display: grid; grid-template-columns: 1fr 1.15fr; gap: 3rem;">
      <div class="contact-info">
        <div class="info-card" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 16px; padding: 2rem; margin-bottom: 1.5rem;">
          <h2 style="color: #fff; font-size: 1.3rem; margin-top: 0;">Direct Contact Details</h2>
          
          <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
            <div>
              <span style="color: #888; font-size: 0.85rem; display: block;">Phone (24/7 Rapid Response):</span>
              <a href={`tel:${business.telephone}`} style="color: var(--accent); font-size: 1.35rem; font-weight: 700; text-decoration: none;">{business.displayPhone}</a>
            </div>

            <div>
              <span style="color: #888; font-size: 0.85rem; display: block;">Direct Email:</span>
              <a href={`mailto:${business.email}`} style="color: #fff; font-size: 1.05rem; text-decoration: underline;">{business.email}</a>
            </div>

            <div>
              <span style="color: #888; font-size: 0.85rem; display: block;">Operational Base:</span>
              <span style="color: #ccc; font-size: 1rem;">Burnside, VIC 3023, Melbourne</span>
            </div>

            <div>
              <span style="color: #888; font-size: 0.85rem; display: block;">Electrical Contractor Licence:</span>
              <span style="color: #ccc; font-size: 1rem;"><strong>{business.recNumber}</strong> (Energy Safe Victoria)</span>
            </div>

            <div>
              <span style="color: #888; font-size: 0.85rem; display: block;">ABN:</span>
              <span style="color: #ccc; font-size: 1rem;">{business.abn}</span>
            </div>
          </div>
        </div>

        <div class="hours-card" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 16px; padding: 2rem;">
          <h3 style="color: #fff; font-size: 1.15rem; margin-top: 0;">Operating Hours</h3>
          <ul style="list-style: none; padding: 0; margin: 1rem 0 0 0; display: flex; flex-direction: column; gap: 0.5rem; color: #ccc;">
            <li style="display: flex; justify-content: space-between;">
              <span>Monday – Friday:</span>
              <strong style="color: #fff;">7:00 AM – 5:00 PM</strong>
            </li>
            <li style="display: flex; justify-content: space-between;">
              <span>Saturday – Sunday:</span>
              <strong style="color: #fff;">Emergency On-Call</strong>
            </li>
            <li style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 0.5rem; margin-top: 0.5rem;">
              <span>Emergency Hazards:</span>
              <strong style="color: var(--accent);">24 Hours / 7 Days</strong>
            </li>
          </ul>
        </div>
      </div>

      <div class="contact-form-col">
        <QuoteForm
          title="Send a Message or Request a Quote"
          subtitle="Fill out your details below and Nick will get back to you promptly."
        />
      </div>
    </div>

    <div class="areas-served-strip" style="margin-top: 4rem; padding: 2.5rem; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 16px;">
      <h3 style="color: #fff; margin-top: 0; font-size: 1.25rem;">Suburbs We Regularly Service</h3>
      <p style="color: #aaa; margin-bottom: 1.25rem;">We provide fast dispatch across all Western Suburbs including:</p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        {business.areasServed.map(area => (
          <a
            href={`/areas/${area.name.toLowerCase().replace(/\s+/g, '-')}/`}
            style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #ddd; padding: 0.4rem 0.85rem; border-radius: 6px; font-size: 0.9rem; text-decoration: none;"
          >
            {area.name} ({area.postcode})
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .lead {
    font-size: 1.15rem;
    color: #ccc;
    line-height: 1.6;
    max-width: 800px;
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
