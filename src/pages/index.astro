---
import business from '../data/business.json';

const title = "Electrician Melbourne West | EV Chargers, Switchboards & Safety | Bara Electrical";
const description = `Licensed electricians (REC ${business.recNumber}) serving Melbourne's west since ${business.foundingYear}. EV charger installation, switchboard upgrades, smart home, CCTV and 24/7 emergency call-outs. ${business.rating.ratingValue} from ${business.rating.reviewCount} Google reviews.`;
const canonical = "https://www.baraelec.com.au/";
const ogImage = "https://www.baraelec.com.au/og-image.jpg";

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  "@id": "https://www.baraelec.com.au/#business",
  "name": business.legalName,
  "alternateName": business.name,
  "url": canonical,
  "image": "https://www.baraelec.com.au/logo1.webp",
  "logo": "https://www.baraelec.com.au/logo1.webp",
  "telephone": business.telephone,
  "email": business.email,
  "foundingDate": String(business.foundingYear),
  "priceRange": business.priceRange,
  "taxID": business.abn,
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "license",
    "name": "Registered Electrical Contractor",
    "recognizedBy": {
      "@type": "GovernmentOrganization",
      "name": business.regulator
    },
    "identifier": business.recNumber
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": business.address.addressLocality,
    "addressRegion": business.address.addressRegion,
    "postalCode": business.address.postalCode,
    "addressCountry": business.address.addressCountry
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": business.geo.latitude,
    "longitude": business.geo.longitude
  },
  "areaServed": business.areasServed.map(area => ({
    "@type": "City",
    "name": area.name
  })),
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "07:00",
      "closes": "17:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "description": "24/7 Emergency Service Available",
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "sameAs": business.sameAs,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": String(business.rating.ratingValue),
    "bestRating": "5",
    "ratingCount": String(business.rating.reviewCount),
    "reviewCount": String(business.rating.reviewCount)
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Electrical Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "EV Charger Installation" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Switchboard Upgrades" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Renovation Wiring & Rewiring" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Smart Home Automation" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CCTV & Security Installation" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "TV Wall Mounting" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "LED Lighting Upgrades" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Electrical Safety & Compliance Testing" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "24/7 Emergency Electrician" } }
    ]
  }
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-022M98FM2Z"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-022M98FM2Z');
  </script>
  
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/logo1.webp">
  <link rel="apple-touch-icon" href="/logo1.webp">
  <link rel="canonical" href={canonical}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={business.name}>
  <meta property="og:locale" content="en_AU">
  <meta property="og:title" content="Electrician Melbourne West | EV Chargers, Switchboards & 24/7 Safety">
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonical}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Electrician Melbourne West | Bara Electrical Servicing">
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />

  <!-- Self-hosted font preload -->
  <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css?v=20260907-v5">
</head>

<body class="dark-mode">
  <!-- Ambient glowing backgrounds -->
  <div class="ambient-bg">
    <div class="glow glow-blue"></div>
    <div class="glow glow-yellow"></div>
    <div class="glow glow-blue-secondary"></div>
    <div class="glow-noise"></div>
  </div>

  <!-- Floating Pill Navbar -->
  <header class="navbar">
    <div class="nav-container glass-panel">
      <div class="logo">
        <a href="/"><img src="/logo1.webp" alt="Bara Electricals Logo" class="brand-logo" width="160" height="160"></a>
      </div>
      <nav class="nav-links">
        <a href="/services/">Services</a>
        <a href="/help/">Troubleshooting</a>
        <a href="/areas/">Service Areas</a>
        <a href="/reviews/">Reviews</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="nav-action">
        <a href={`tel:${business.telephone}`} class="nav-phone-btn" aria-label="Call Bara Electricals">
          <span class="nav-phone-icon">📞</span>
          <span class="nav-phone-text">{business.displayPhone}</span>
        </a>
        <a href="#contact" class="magic-shimmer-btn">
          <div class="shimmer-overlay"></div>
          <div class="btn-content">
            <span class="btn-text">Get a Free Quote</span>
            <span class="btn-icon">↗</span>
          </div>
        </a>
        <button class="mobile-menu-toggle" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section id="home" class="hero section-padding">
      <div class="container hero-content">
        <div class="hero-text glass-card-translucent">
          <div class="badge glass-badge">Established Since {business.foundingYear} • {business.recNumber}</div>
          <h1>TOP LICENSED ELECTRICIANS IN<br><span class="aura-text">MELBOURNE'S WEST</span> &<br>VICTORIA</h1>
          <p>Master licensed electricians providing precision, safety, and 24/7 reliability — trusted across Melbourne West for EV chargers, switchboard upgrades, smart home automation, and emergency call-outs.</p>
          <div class="hero-actions mt-4" style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="#services" class="magic-shimmer-btn btn-lg">
              <div class="shimmer-overlay"></div>
              <div class="btn-content">
                <span class="btn-text">See Services</span>
                <span class="btn-icon">↗</span>
              </div>
            </a>
            <a href={`tel:${business.telephone}`} class="nav-phone-btn" style="padding: 0.8rem 1.6rem; font-size: 1.05rem;" data-gtag="call">
              <span>⚡ Call {business.displayPhone}</span>
            </a>
          </div>
        </div>

        <div class="hero-bg-image">
          <div class="video-overlay"></div>
        </div>

        <div class="hero-graphics">
          <div class="abstract-shape">
            <div class="shape-inner">
              <img src="/nick-electrician.webp" alt="Nick, Master Electrician serving Melbourne and Victoria" class="hero-portrait" width="800" height="1066" fetchpriority="high">
            </div>
            <div class="shape-outline"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="services py-20 relative">
      <div class="container relative z-10">
        <div class="section-header text-center mb-16 fade-up">
          <h2>Our Electrical <span class="aura-text">Expertise</span></h2>
          <p>Comprehensive residential, commercial, and emergency electrical services delivered across Melbourne's West.</p>
        </div>
        <div class="bento-grid">
          <!-- 1. EV Chargers -->
          <a href="/services/ev-charger-installation/" class="bento-card bento-cell-large fade-up" style="text-decoration: none; color: inherit;">
            <img src="/Images/ev-charger-installation.webp" alt="EV Charger installation in Melbourne West" loading="lazy" class="bento-bg-image" width="1100" height="470">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">⚡</div>
            <div><div class="bento-icon">🔌</div></div>
            <div class="bento-content">
              <h3>EV Charger Installation</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Effortless Morning Departures</p>
              <p>Fast, safe Level 2 home & commercial EV charger installations for Tesla, BYD, and universal electric vehicles.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 2. Switchboards -->
          <a href="/services/switchboard-upgrades/" class="bento-card bento-cell-standard fade-up" style="transition-delay: 100ms; text-decoration: none; color: inherit;">
            <img src="/Images/switchboard-upgrades.webp" alt="Safe and compliant switchboard upgrades across Melbourne West" loading="lazy" class="bento-bg-image" width="1000" height="652">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">🛡️</div>
            <div><div class="bento-icon">🛡️</div></div>
            <div class="bento-content">
              <h3>Switchboard Upgrades</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Unwavering Power Safety</p>
              <p>Replace outdated ceramic fuses with modern RCBO safety switches, surge protection, and mains capacity upgrades.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 3. Renovations -->
          <a href="/services/rewiring-and-renovations/" class="bento-card bento-cell-standard fade-up" style="transition-delay: 200ms; text-decoration: none; color: inherit;">
            <img src="/Images/renovation-rewiring.webp" alt="Electrical integration for residential home renovations" loading="lazy" class="bento-bg-image" width="1100" height="849">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">🏗️</div>
            <div><div class="bento-icon">🏗️</div></div>
            <div class="bento-content">
              <h3>Renovation Wiring & Rewiring</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Your Dream Space, Realized</p>
              <p>Architectural lighting design, power circuits, and full home rewiring for extensions, kitchen makeovers, and new builds.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 4. Smart Home -->
          <a href="/services/smart-home-automation/" class="bento-card bento-cell-standard fade-up" style="text-decoration: none; color: inherit;">
            <img src="/Images/smart-home-automation.webp" alt="Smart home automation electrical systems" loading="lazy" class="bento-bg-image" width="1100" height="600">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">📱</div>
            <div><div class="bento-icon">📱</div></div>
            <div class="bento-content">
              <h3>Smart Home Automation</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Seamless Intuitive Control</p>
              <p>Intelligent lighting automation, smart switches, voice assistants, and energy monitoring for effortless comfort.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 5. CCTV -->
          <a href="/services/cctv-and-security-cameras/" class="bento-card bento-cell-standard fade-up" style="transition-delay: 100ms; text-decoration: none; color: inherit;">
            <img src="/Images/cctv-security-installation.webp" alt="Professional security camera network installation" loading="lazy" class="bento-bg-image" width="1100" height="600">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">👁️</div>
            <div><div class="bento-icon">👁️</div></div>
            <div class="bento-content">
              <h3>CCTV & Security Installation</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">24/7 Unblinking Peace of Mind</p>
              <p>High-definition 4K IP security cameras, video doorbells, and remote smartphone monitoring with no blind spots.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 6. TV Installations -->
          <a href="/services/tv-wall-mounting/" class="bento-card bento-cell-standard fade-up" style="transition-delay: 200ms; text-decoration: none; color: inherit;">
            <img src="/Images/tv-wall-mounting.webp" alt="Wall mounted TV installations with hidden wiring" loading="lazy" class="bento-bg-image" width="1100" height="1100">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">📺</div>
            <div><div class="bento-icon">📺</div></div>
            <div class="bento-content">
              <h3>TV Wall Mounting</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Cinematic Viewing Perfection</p>
              <p>Heavy-duty bracket installation, concealed in-wall cabling, power point relocation, and soundbar setup.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 7. Lighting Upgrades -->
          <a href="/services/led-lighting/" class="bento-card bento-cell-wide fade-up" style="text-decoration: none; color: inherit;">
            <img src="/Images/led-lighting-upgrades.webp" alt="Modern interior and exterior LED lighting upgrades" loading="lazy" class="bento-bg-image" width="1100" height="613">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">✨</div>
            <div><div class="bento-icon">💡</div></div>
            <div class="bento-content">
              <h3>LED Lighting Upgrades</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Atmosphere on Demand</p>
              <p>Energy-efficient LED downlights, dimmers, pendant lights, security floodlights, and garden lighting.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>

          <!-- 8. Compliance -->
          <a href="/services/electrical-safety-inspections/" class="bento-card bento-cell-standard fade-up compliance-card" style="transition-delay: 100ms; text-decoration: none; color: inherit;">
            <img src="/Images/safety-compliance-testing.webp" alt="Certified electrical compliance checks and fault finding" loading="lazy" class="bento-bg-image" width="1100" height="450">
            <div class="bento-bg-overlay"></div>
            <div class="bento-graphic">✅</div>
            <div><div class="bento-icon">✅</div></div>
            <div class="bento-content">
              <h3>Electrical Safety & Compliance Testing</h3>
              <p class="card-tagline" style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem;">Absolute Legal Confidence</p>
              <p>Victorian rental compliance safety audits, RCD trip time testing, smoke alarm checks, and Certificates of Electrical Safety.</p>
            </div>
            <div class="bento-arrow">↗</div>
          </a>
        </div>
      </div>
    </section>

    <!-- Reviews Section -->
    <section id="testimonials" class="reviews section-padding relative-z">
      <div class="container">
        <div class="section-header glass-header">
          <h2>Trusted by the Community</h2>
          <p>Here's what our clients have to say about our premium service.</p>
        </div>
        <div class="marquee-wrapper">
          <div class="marquee-track">
            <div class="glass-card testimonial-card glow-border"><div class="stars text-primary">★★★★★</div><p class="review-text">"I have used Nick many times, what a wonderful bloke and always punctual... The costs are always cheaper than other vendors. Always happy to recommend Bara Electricals."</p><div class="reviewer"><div class="avatar bg-accent">GS</div><div class="reviewer-info"><h4>Guri Singh</h4><span>Verified Customer</span></div></div></div>
            <div class="glass-card testimonial-card"><div class="stars">★★★★★</div><p class="review-text">"It’s not often that your plans and ideas turn out exactly how you visualised them. Nick and the boys from Bara Electrical Servicing were outstanding."</p><div class="reviewer"><div class="avatar bg-primary text-dark">DM</div><div class="reviewer-info"><h4>David Miller</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card"><div class="stars">★★★★★</div><p class="review-text">"Referred by a friend, Nick and crew came spot on time. Very professional and crew were friendly... Installed a 32amp industrial outlet for ev charger. Highly recommend!"</p><div class="reviewer"><div class="avatar bg-accent">CM</div><div class="reviewer-info"><h4>Chok Monn</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card glow-border"><div class="stars text-primary">★★★★★</div><p class="review-text">"Nick is the best electrician I've ever had the pleasure to deal with, fantastic customer service, reliable and a great bloke... Highly highly recommended."</p><div class="reviewer"><div class="avatar bg-primary text-dark">LV</div><div class="reviewer-info"><h4>Luis Vargas</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card"><div class="stars">★★★★★</div><p class="review-text">"Nick, Henry and Dean did an amazing job setting up the wall mount for our TV. Nick and his team were highly professional, polite, on time..."</p><div class="reviewer"><div class="avatar bg-accent">HN</div><div class="reviewer-info"><h4>Hung Nguyen</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card"><div class="stars">★★★★★</div><p class="review-text">"Very professional - high quality work with clean and neat installations... Received quote same day, and was on time for the work."</p><div class="reviewer"><div class="avatar bg-accent">AC</div><div class="reviewer-info"><h4>Aditya Chordia</h4><span>Google Reviewer</span></div></div></div>
            
            <!-- Seamless infinite loop replica -->
            <div class="glass-card testimonial-card glow-border" aria-hidden="true"><div class="stars text-primary">★★★★★</div><p class="review-text">"I have used Nick many times, what a wonderful bloke and always punctual... The costs are always cheaper than other vendors. Always happy to recommend Bara Electricals."</p><div class="reviewer"><div class="avatar bg-accent">GS</div><div class="reviewer-info"><h4>Guri Singh</h4><span>Verified Customer</span></div></div></div>
            <div class="glass-card testimonial-card" aria-hidden="true"><div class="stars">★★★★★</div><p class="review-text">"It’s not often that your plans and ideas turn out exactly how you visualised them. Nick and the boys from Bara Electrical Servicing were outstanding."</p><div class="reviewer"><div class="avatar bg-primary text-dark">DM</div><div class="reviewer-info"><h4>David Miller</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card" aria-hidden="true"><div class="stars">★★★★★</div><p class="review-text">"Referred by a friend, Nick and crew came spot on time. Very professional and crew were friendly... Installed a 32amp industrial outlet for ev charger. Highly recommend!"</p><div class="reviewer"><div class="avatar bg-accent">CM</div><div class="reviewer-info"><h4>Chok Monn</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card glow-border" aria-hidden="true"><div class="stars text-primary">★★★★★</div><p class="review-text">"Nick is the best electrician I've ever had the pleasure to deal with, fantastic customer service, reliable and a great bloke... Highly highly recommended."</p><div class="reviewer"><div class="avatar bg-primary text-dark">LV</div><div class="reviewer-info"><h4>Luis Vargas</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card" aria-hidden="true"><div class="stars">★★★★★</div><p class="review-text">"Nick, Henry and Dean did an amazing job setting up the wall mount for our TV. Nick and his team were highly professional, polite, on time..."</p><div class="reviewer"><div class="avatar bg-accent">HN</div><div class="reviewer-info"><h4>Hung Nguyen</h4><span>Google Reviewer</span></div></div></div>
            <div class="glass-card testimonial-card" aria-hidden="true"><div class="stars">★★★★★</div><p class="review-text">"Very professional - high quality work with clean and neat installations... Received quote same day, and was on time for the work."</p><div class="reviewer"><div class="avatar bg-accent">AC</div><div class="reviewer-info"><h4>Aditya Chordia</h4><span>Google Reviewer</span></div></div></div>
          </div>
        </div>

        <div style="text-align: center; margin-top: 3rem; margin-bottom: 2rem; position: relative; z-index: 10;">
          <a href="https://www.google.com/search?q=bara+electricals+reviews" target="_blank" rel="noopener" class="glow-border read-all-link">
            Read all {business.rating.reviewCount}+ Google Reviews ({business.rating.ratingValue} ★) <span style="color: var(--color-primary); margin-left: 5px;">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contact" class="contact section-padding relative-z">
      <div class="container">
        <div class="glass-card contact-wrapper p-0">
          <div class="contact-info glass-panel-dark">
            <h2>Ready for a Quote?</h2>
            <p class="mb-4">Get in touch today for a free, no-obligation quote. Fill out the form, and we'll get back to you in a flash.</p>

            <div class="info-items mt-4">
              <div class="info-item">
                <span class="icon-glass">📞</span>
                <div>
                  <h4>Call Us (24/7)</h4>
                  <p><a href={`tel:${business.telephone}`} class="tel-link" data-gtag="call">{business.displayPhone}</a></p>
                </div>
              </div>
              <div class="info-item">
                <span class="icon-glass">✉️</span>
                <div>
                  <h4>Email Us</h4>
                  <p><a href={`mailto:${business.email}`} class="email-link">{business.email}</a></p>
                </div>
              </div>
              <div class="info-item">
                <span class="icon-glass">🕒</span>
                <div>
                  <h4>Operating Hours</h4>
                  <p>Mon - Fri: 7:00 AM - 5:00 PM</p>
                  <p class="text-primary text-sm mt-1">24/7 Emergency Call-outs Available</p>
                </div>
              </div>
            </div>
          </div>
          <div class="contact-form-container">
            <form id="lead-form" class="glass-form">
              <input type="hidden" name="access_key" value="a5824cbf-706f-45b6-9bb8-ffba5e56d7fb" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off">
              <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required placeholder="John Doe">
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" required placeholder="0400 000 000">
              </div>
              <div class="form-group">
