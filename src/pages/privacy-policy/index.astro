---
import BaseLayout from '../../layouts/BaseLayout.astro';
import business from '../../data/business.json';

const title = `Privacy Policy | ${business.name}`;
const description = `Privacy Policy for ${business.legalName} (ABN ${business.abn}, ${business.recNumber}). Learn how we collect, handle, and protect your personal information.`;
const canonical = "https://www.baraelec.com.au/privacy-policy/";
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="legal-page-container" style="padding: 120px 20px 80px 20px; max-width: 900px; margin: 0 auto; position: relative; z-index: 10;">
    <a href="/" style="display: inline-flex; align-items: center; gap: 6px; color: var(--color-primary); font-weight: 600; margin-bottom: 1.5rem; text-decoration: none;">&larr; Return to Home</a>
    
    <article class="glass-card" style="background: rgba(10, 15, 30, 0.8); backdrop-filter: blur(25px); border-radius: 24px; padding: 3rem 2.5rem; border: 1px solid rgba(255,255,255,0.08);">
      <header style="margin-bottom: 2.5rem;">
        <div class="badge glass-badge" style="margin-bottom: 1rem;">Compliance & Trust</div>
        <h1 class="aura-text" style="font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #fff;">Privacy Policy</h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Last Updated: September 2026 • {business.legalName} (ABN {business.abn}, {business.recNumber})</p>
      </header>

      <div class="legal-content">
        <p>{business.legalName} ("we", "us", or "our") is committed to protecting your privacy in accordance with the <em>Privacy Act 1988</em> (Cth) and the Australian Privacy Principles (APPs). This Privacy Policy explains how we collect, use, disclose, and safeguard your personal information when you visit our website <a href="https://www.baraelec.com.au" style="color: var(--color-primary);">www.baraelec.com.au</a> or engage our electrical contracting services.</p>

        <h2>1. Information We Collect</h2>
        <p>We may collect personal information that you voluntarily provide to us when you request an electrical quote, book a call-out, or contact us. This may include:</p>
        <ul>
          <li><strong>Contact Information:</strong> Full name, phone number, email address, and service address.</li>
          <li><strong>Job Details:</strong> Nature of the electrical work, fault descriptions, project requirements, and service property access instructions.</li>
          <li><strong>Technical & Analytics Data:</strong> IP address, device type, browser information, pages visited, and interaction data collected through Google Analytics 4 to improve website functionality and user experience.</li>
        </ul>

        <h2>2. How We Use Your Information</h2>
        <p>We collect and use your personal information solely for legitimate trade and business purposes, including:</p>
        <ul>
          <li>Providing free quotes and scheduling electrical appointments and emergency call-outs.</li>
          <li>Executing residential and commercial electrical installations, safety inspections, and compliance certifications (Certificates of Electrical Safety).</li>
          <li>Communicating with you regarding job status, invoices, warranties, and customer service.</li>
          <li>Complying with statutory trade obligations under Energy Safe Victoria (ESV) and Victorian electrical safety regulations.</li>
        </ul>

        <h2>3. Disclosure of Personal Information</h2>
        <p>We do not sell, rent, or trade your personal information. We may disclose your information only in limited circumstances:</p>
        <ul>
          <li>To licensed tradespeople, apprentices, or subcontractors working under our supervision to deliver your scheduled electrical work.</li>
          <li>To regulatory bodies, such as Energy Safe Victoria (ESV), for the mandatory lodgement of Prescribed and Non-Prescribed Certificates of Electrical Safety.</li>
          <li>To trusted service providers who assist our business operations (e.g. form processing, cloud communication, accounting platforms), bound by confidentiality obligations.</li>
          <li>Where required or authorised by Australian law or court order.</li>
        </ul>

        <h2>4. Data Security & Storage</h2>
        <p>We implement appropriate physical, technical, and administrative security measures to protect your personal information against misuse, loss, unauthorised access, modification, or disclosure. When personal information is no longer needed or required by law, we take reasonable steps to securely destroy or de-identify it.</p>

        <h2>5. Access and Correction</h2>
        <p>Under the Australian Privacy Principles, you have the right to request access to the personal information we hold about you and request corrections if you believe it is inaccurate, out of date, or incomplete. To make an enquiry or request, please contact us using the details below.</p>

        <h2>6. Contact Us</h2>
        <p>If you have any questions, concerns, or complaints regarding this Privacy Policy or our privacy practices, please reach out to us:</p>
        <p>
          <strong>{business.legalName}</strong><br>
          ABN: {business.abn} • REC: {business.recNumber}<br>
          {business.address.addressLocality} VIC {business.address.postalCode}, Australia<br>
          Phone: <a href={`tel:${business.telephone}`} style="color: var(--color-primary);">{business.displayPhone}</a><br>
          Email: <a href={`mailto:${business.email}`} style="color: var(--color-primary);">{business.email}</a>
        </p>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .legal-content h2 {
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary, #f5a623);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.4rem;
  }
  .legal-content p, .legal-content li {
    color: #cbd5e1;
    line-height: 1.8;
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .legal-content ul {
    padding-left: 1.8rem;
    margin-bottom: 1.5rem;
  }
  .legal-content strong {
    color: #ffffff;
  }
</style>
