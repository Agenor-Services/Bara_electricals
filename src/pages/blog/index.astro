---
import BaseLayout from '../../layouts/BaseLayout.astro';
import business from '../../data/business.json';

const title = `Electrical Guides, Tips & Advice | ${business.name}`;
const description = `Expert electrical tips, guides, and advice from licensed electricians in Melbourne's West. Learn about EV chargers, switchboards, safety compliance & emergency response.`;
const canonical = "https://www.baraelec.com.au/blog/";

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://www.baraelec.com.au/blog/#webpage",
  "url": canonical,
  "name": `Electrical Guides & Insights — ${business.name}`,
  "description": "Expert electrical tips and advice from licensed electricians across Melbourne's West.",
  "publisher": {
    "@type": "Organization",
    "name": business.legalName,
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.baraelec.com.au/logo1.webp"
    }
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.baraelec.com.au/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": canonical
      }
    ]
  }
};
---
<BaseLayout title={title} description={description} canonical={canonical} schema={collectionSchema}>
  <div style="padding-top: 140px; padding-bottom: 80px; position: relative; z-index: 10;">
    <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 20px;">
      <nav aria-label="Breadcrumb" class="breadcrumbs" style="margin-bottom: 1.5rem; font-size: 0.95rem; color: var(--text-muted);">
        <a href="/" style="color: var(--color-primary); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; opacity: 0.5;">/</span>
        <span style="color: var(--text-main);">Blog</span>
      </nav>

      <div class="section-header text-center mb-12" style="text-align: center; margin-bottom: 3rem;">
        <div class="badge glass-badge" style="margin-bottom: 1rem; display: inline-block;">Trade Knowledge & Insights</div>
        <h1 class="aura-text" style="font-size: clamp(2.2rem, 5vw, 3.5rem); margin-bottom: 1rem; color: #fff;">Electrical Guides & Advice</h1>
        <p style="max-width: 680px; margin: 0 auto; color: var(--text-muted);">Practical guides, safety tips, and technical insights from master licensed electricians serving Melbourne's Western suburbs.</p>
      </div>

      <div class="blog-grid">
        <!-- Article 1: Emergency Electrician West Melbourne -->
        <a href="/blog/emergency-electrician-west-melbourne/" class="blog-card glow-border">
          <img src="/background.webp" alt="Emergency Electrician West Melbourne 24/7" class="blog-card-img" width="1100" height="470" loading="lazy">
          <div class="blog-card-body">
            <span class="blog-card-tag">⚡ 24/7 Emergency Safety</span>
            <h2 class="blog-card-title">Emergency Electrician West Melbourne: 24/7 Rapid Response Guide</h2>
            <p class="blog-card-desc">Electrical emergencies don't wait for business hours. Learn what constitutes an electrical hazard, immediate steps to take, and when to call a 24/7 licensed sparky.</p>
            <div class="blog-card-footer">
              <span>By Nick (REC 29064)</span>
              <span style="color: var(--color-primary); font-weight: 600;">Read Guide ↗</span>
            </div>
          </div>
        </a>

        <!-- Service Spotlight 1: EV Charger Installation -->
        <a href="/services/ev-charger-installation/" class="blog-card">
          <img src="/Images/ev-charger-installation.webp" alt="EV Charger installation guide Melbourne" class="blog-card-img" width="1100" height="470" loading="lazy">
          <div class="blog-card-body">
            <span class="blog-card-tag">🔌 EV Charging Guide</span>
            <h2 class="blog-card-title">Home EV Charger Installation: What Melbourne Homeowners Need to Know</h2>
            <p class="blog-card-desc">Everything about Level 2 EV charging at home, single-phase vs three-phase power considerations, and charging speed benchmarks for Tesla and BYD.</p>
            <div class="blog-card-footer">
              <span>Service Guide</span>
              <span style="color: var(--color-primary); font-weight: 600;">View Details ↗</span>
            </div>
          </div>
        </a>

        <!-- Service Spotlight 2: Switchboard Upgrades -->
        <a href="/services/switchboard-upgrades/" class="blog-card">
          <img src="/Images/switchboard-upgrades.webp" alt="Switchboard upgrade guide Melbourne" class="blog-card-img" width="1000" height="652" loading="lazy">
          <div class="blog-card-body">
            <span class="blog-card-tag">🛡️ Electrical Safety</span>
            <h2 class="blog-card-title">Signs Your Switchboard Needs an Immediate Upgrade</h2>
            <p class="blog-card-desc">Still have old ceramic fuses? Learn how modern RCBO safety switches protect against fatal electrical shocks, overheating wires, and electrical house fires.</p>
            <div class="blog-card-footer">
              <span>Safety Checklist</span>
              <span style="color: var(--color-primary); font-weight: 600;">View Details ↗</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Emergency Box -->
      <div style="margin-top: 4rem; padding: 2.5rem; background: rgba(10, 15, 30, 0.85); border: 1px solid rgba(223, 255, 0, 0.3); border-radius: 20px; text-align: center;">
        <h3 style="color: #ffffff; font-size: 1.8rem; margin-bottom: 0.8rem;">Have an Urgent Electrical Issue Right Now?</h3>
        <p style="color: #cbd5e1; max-width: 600px; margin: 0 auto 1.5rem auto;">We are on call 24 hours a day, 7 days a week across Burnside, Caroline Springs, Melton, and all western suburbs.</p>
        <a href={`tel:${business.telephone}`} class="magic-shimmer-btn btn-lg" style="display: inline-flex; text-decoration: none;" data-gtag="call">
          <div class="shimmer-overlay"></div>
          <div class="btn-content">
            <span class="btn-text">Call {business.displayPhone} Immediately</span>
            <span class="btn-icon">⚡</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .blog-card {
    background: rgba(10, 15, 30, 0.75);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .blog-card:hover {
    transform: translateY(-6px);
    border-color: rgba(223, 255, 0, 0.4);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5), 0 0 20px rgba(223, 255, 0, 0.15);
  }
  .blog-card-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .blog-card-body {
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .blog-card-tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary, #f5a623);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.8rem;
  }
  .blog-card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.8rem;
    line-height: 1.35;
  }
  .blog-card-desc {
    font-size: 0.95rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }
  .blog-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }
</style>
