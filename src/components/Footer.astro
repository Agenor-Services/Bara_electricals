---
import business from '../data/business.json';
---
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <img src="/logo1.webp" alt="Bara Electrical Servicing" width="50" height="50" />
          <div>
            <h3>BARA ELECTRICAL</h3>
            <p class="tagline">SERVICING MELBOURNE WEST</p>
          </div>
        </div>
        <p class="desc">Fully licensed, insured, and Energy Safe Victoria accredited electrical contractors. Specialising in domestic & commercial electrical excellence.</p>
        <div class="credentials-badge">
          <span>Licence: {business.recNumber}</span> · <span>ABN: {business.abn}</span>
        </div>
        <p class="direct-contact">
          Direct: <a href={`tel:${business.telephone}`}>{business.displayPhone}</a><br/>
          Email: <a href={`mailto:${business.email}`}>{business.email}</a>
        </p>
      </div>

      <div class="footer-col">
        <h4>Core Services</h4>
        <ul class="footer-links">
          <li><a href="/services/emergency-electrician/">24/7 Emergency Electrician</a></li>
          <li><a href="/services/ev-charger-installation/">EV Charger Installation</a></li>
          <li><a href="/services/switchboard-upgrades/">Switchboard Upgrades</a></li>
          <li><a href="/services/safety-switch-rcd-installation/">Safety Switches & RCDs</a></li>
          <li><a href="/services/rewiring-and-renovations/">Rewiring & Renovations</a></li>
          <li><a href="/services/smart-home-automation/">Smart Home Automation</a></li>
          <li><a href="/services/cctv-and-security-cameras/">CCTV & Security Cameras</a></li>
          <li><a href="/services/led-lighting/">LED Lighting Upgrades</a></li>
          <li><a href="/services/electrical-safety-inspections/">Safety Inspections & Testing</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Western Suburbs Serviced</h4>
        <ul class="footer-links suburb-grid">
          {business.areasServed.map((area) => (
            <li><a href={`/areas/${area.name.toLowerCase().replace(/\s+/g, '-')}/`}>{area.name} ({area.postcode})</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Trust & Resources</h4>
        <ul class="footer-links">
          <li><a href="/about/">About Us</a></li>
          <li><a href="/about/nick/">Nick (REC 29064)</a></li>
          <li><a href="/reviews/">Customer Reviews (5.0 ★)</a></li>
          <li><a href="/guarantee/">Workmanship Guarantee</a></li>
          <li><a href="/help/">Troubleshooting & Diagnostic Hub</a></li>
          <li><a href="/glossary/">Electrical Glossary</a></li>
          <li><a href="/faq/">Frequently Asked Questions</a></li>
          <li><a href="/contact/">Contact & Bookings</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
        <div class="rating-box">
          <div class="stars">★★★★★</div>
          <p><strong>{business.rating.ratingValue}.0 / 5.0</strong> across {business.rating.reviewCount}+ Google Reviews</p>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved. Registered Electrical Contractor REC 29064 · Regulated by Energy Safe Victoria.</p>
      <p style="margin-top: 0.5rem; font-size: 0.85rem; color: #94a3b8;">Built and designed by <a href="https://www.agenorit.com.au" target="_blank" rel="noopener" style="color: var(--accent, #f5a623); font-weight: 600; text-decoration: underline;">Agenor Services Pty Ltd</a></p>
    </div>
  </div>
</footer>
