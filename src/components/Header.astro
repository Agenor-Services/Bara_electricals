---
import business from '../data/business.json';
---
<header class="site-header">
  <div class="header-container">
    <a href="/" class="logo-link">
      <img src="/logo1.webp" alt="Bara Electrical Servicing" width="60" height="60" class="site-logo" />
      <div class="logo-text">
        <span class="brand-name">BARA ELECTRICAL</span>
        <span class="brand-sub">SERVICING · REC 29064</span>
      </div>
    </a>

    <nav class="main-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="/#services">Services</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href="/#reviews">Reviews</a></li>
        <li><a href="/blog/">Guides</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="header-cta">
      <a href={`tel:${business.telephone}`} class="phone-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>{business.displayPhone}</span>
      </a>
      <a href="/#contact" class="btn-primary quote-btn">Get a Quote</a>
    </div>

    <button class="mobile-menu-btn" aria-label="Toggle menu" id="mobile-menu-toggle">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
