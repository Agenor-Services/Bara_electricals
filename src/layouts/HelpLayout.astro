---
import BaseLayout from './BaseLayout.astro';
import AnswerFirst from '../components/AnswerFirst.astro';
import AuthorCredit from '../components/AuthorCredit.astro';
import FaqBlock from '../components/FaqBlock.astro';
import QuoteForm from '../components/QuoteForm.astro';
import business from '../data/business.json';

interface FAQItem {
  question: string;
  answer: string;
}

interface CauseItem {
  title: string;
  description: string;
}

interface Props {
  title: string;
  h1: string;
  metaDescription: string;
  answerFirst: string;
  safetyWarning: string;
  causes?: CauseItem[];
  diyChecks?: string[];
  licensedRequirements?: string[];
  faqs?: FAQItem[];
  relatedService?: string;
  lastReviewed?: string;
}

const {
  title,
  h1,
  metaDescription,
  answerFirst,
  safetyWarning,
  causes = [],
  diyChecks = [],
  licensedRequirements = [],
  faqs = [],
  relatedService = "/services/switchboard-upgrades-melbourne/",
  lastReviewed = "7 September 2026"
} = Astro.props;

const canonicalUrl = Astro.url.href;

const helpSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": h1,
      "description": metaDescription,
      "datePublished": "2026-09-07T00:00:00+10:00",
      "dateModified": "2026-09-07T00:00:00+10:00",
      "author": {
        "@type": "Person",
        "name": "Nick",
        "jobTitle": "Licensed Electrician",
        "hasCredential": {
          "@type": "EducationalOccupationalCredential",
          "identifier": business.recNumber
        },
        "worksFor": {
          "@type": "Electrician",
          "@id": "https://www.baraelec.com.au/#electrician"
        }
      },
      "publisher": {
        "@type": "Organization",
        "name": business.name,
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.baraelec.com.au/logo1.webp"
        }
      },
      "mainEntityOfPage": canonicalUrl
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.baraelec.com.au/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Help & Diagnostics",
          "item": "https://www.baraelec.com.au/help/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": h1,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---
<BaseLayout title={title} description={metaDescription} canonical={canonicalUrl} schema={helpSchema}>
  <article class="landing-page help-landing">
    <div class="landing-container">
      
      <!-- Breadcrumbs -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span class="sep">›</span></li>
          <li><a href="/help/">Help & Diagnostics</a></li>
          <li><span class="sep">›</span></li>
          <li aria-current="page">{h1}</li>
        </ol>
      </nav>

      <!-- Main Header -->
      <header class="landing-header">
        <h1>{h1}</h1>
        <p class="license-subtitle">Electrical Safety Guide · Verified against Australian Standard AS/NZS 3000</p>
      </header>

      <!-- Answer-First Passage for AI Overview Retrieval -->
      <AnswerFirst text={answerFirst} badge="Quick Diagnostic Answer" />

      <!-- Immediate Safety Callout -->
      <div class="safety-alert-box">
        <div class="safety-icon">⚠️</div>
        <div class="safety-content">
          <h4>Immediate Safety Warning</h4>
          <p>{safetyWarning}</p>
        </div>
      </div>

      <!-- Main Article Content -->
      <div class="landing-content">
        <slot />

        <!-- Common Causes Breakdown -->
        {causes && causes.length > 0 && (
          <section class="causes-section">
            <h2>Common Causes of This Issue</h2>
            <div class="causes-grid">
              {causes.map((cause) => (
                <div class="cause-card">
                  <h3>{cause.title}</h3>
                  <p>{cause.description}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- DIY Safety Checks vs Licensed Work -->
        <section class="safety-boundary-section">
          <h2>What You Can Check Safely vs What Requires a Licensed Electrician</h2>
          <div class="boundary-grid">
            <div class="boundary-card diy-card">
              <h3 class="card-title">✅ What You Can Check Yourself</h3>
              <ul>
                {diyChecks.map((check) => (
                  <li>{check}</li>
                ))}
              </ul>
            </div>
            <div class="boundary-card licensed-card">
              <h3 class="card-title">⛔ Requires a Licensed Electrician (REC)</h3>
              <ul>
                {licensedRequirements.map((req) => (
                  <li>{req}</li>
                ))}
              </ul>
              <p class="compliance-note">Under Victorian law, all fixed electrical wiring, switchboard modifications, and power point replacements must be performed by a Registered Electrical Contractor (REC) and issued a Certificate of Electrical Safety (CES).</p>
            </div>
          </div>
        </section>
      </div>

      <!-- Author Verification Strip -->
      <AuthorCredit lastReviewed={lastReviewed} />

      <!-- FAQ Section -->
      {faqs && faqs.length > 0 && (
        <FaqBlock faqs={faqs} title="Frequently Asked Diagnostics Questions" />
      )}

      <!-- Conversion CTA -->
      <div class="cta-form-section">
        <QuoteForm 
          title="Need On-Site Diagnostic Assistance?" 
          subtitle="Nick is available for emergency fault finding across Melbourne's West" 
        />
      </div>

    </div>
  </article>
</BaseLayout>

<style>
  .landing-page {
    padding: 3rem 1.5rem 5rem 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    color: #e0e0e0;
  }
  .breadcrumb-nav ol {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    font-size: 0.88rem;
    color: #888;
    gap: 0.5rem;
    align-items: center;
  }
  .breadcrumb-nav a {
    color: #aaa;
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: var(--accent, #f5a623);
  }
  .breadcrumb-nav [aria-current="page"] {
    color: var(--accent, #f5a623);
  }
  .landing-header h1 {
    font-size: 2.3rem;
    line-height: 1.25;
    margin-bottom: 0.5rem;
    color: #fff;
    font-family: 'Cinzel', serif;
  }
  .license-subtitle {
    font-size: 0.95rem;
    color: #888;
    margin-bottom: 1.5rem;
  }
  .safety-alert-box {
    display: flex;
    gap: 1rem;
    background: rgba(220, 53, 69, 0.12);
    border: 1px solid rgba(220, 53, 69, 0.35);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0 2rem 0;
  }
  .safety-icon {
    font-size: 1.8rem;
    line-height: 1;
  }
  .safety-content h4 {
    color: #ff6b6b;
    margin: 0 0 0.4rem 0;
    font-size: 1.05rem;
  }
  .safety-content p {
    margin: 0;
    line-height: 1.5;
    color: #f0f0f0;
    font-size: 0.95rem;
  }
  .causes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin: 1.5rem 0;
  }
  .cause-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1.2rem;
  }
  .cause-card h3 {
    color: var(--accent, #f5a623);
    font-size: 1.15rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .cause-card p {
    margin: 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .boundary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  .boundary-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .boundary-card.diy-card {
    border-left: 4px solid #28a745;
  }
  .boundary-card.licensed-card {
    border-left: 4px solid #dc3545;
  }
  .boundary-card .card-title {
    font-size: 1.1rem;
    margin-top: 0;
    margin-bottom: 1rem;
    color: #fff;
  }
  .boundary-card ul {
    padding-left: 1.2rem;
    margin-bottom: 1rem;
  }
  .boundary-card li {
    margin-bottom: 0.6rem;
    line-height: 1.5;
    font-size: 0.92rem;
  }
  .compliance-note {
    font-size: 0.8rem;
    color: #999;
    font-style: italic;
    line-height: 1.5;
    margin: 0;
  }
  .cta-form-section {
    margin-top: 4rem;
  }
</style>
