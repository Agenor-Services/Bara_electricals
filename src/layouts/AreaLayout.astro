---
import BaseLayout from './BaseLayout.astro';
import AnswerFirst from '../components/AnswerFirst.astro';
import AuthorCredit from '../components/AuthorCredit.astro';
import FaqBlock from '../components/FaqBlock.astro';
import QuoteForm from '../components/QuoteForm.astro';
import business from '../data/business.json';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  h1: string;
  metaDescription: string;
  suburb: string;
  postcode: string;
  answerFirst: string;
  housingEra: string;
  typicalIssues?: string[];
  faqs?: FAQItem[];
  lastReviewed?: string;
}

const {
  title,
  h1,
  metaDescription,
  suburb,
  postcode,
  answerFirst,
  housingEra,
  typicalIssues = [],
  faqs = [],
  lastReviewed = "7 September 2026"
} = Astro.props;

const canonicalUrl = Astro.url.href;

const areaSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Electrician",
      "@id": `${canonicalUrl}#local-electrician`,
      "name": `${business.name} - ${suburb}`,
      "telephone": business.telephone,
      "priceRange": business.priceRange,
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "identifier": business.recNumber
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": `${suburb} VIC ${postcode}`
      },
      "parentOrganization": {
        "@type": "Electrician",
        "@id": "https://www.baraelec.com.au/#electrician"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.baraelec.com.au/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Service Areas",
          "item": "https://www.baraelec.com.au/#areas"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${suburb} VIC ${postcode}`,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---
<BaseLayout title={title} description={metaDescription} canonical={canonicalUrl} schema={areaSchema}>
  <article class="landing-page area-landing">
    <div class="landing-container">
      
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span class="sep">›</span></li>
          <li><a href="/#areas">Areas</a></li>
          <li><span class="sep">›</span></li>
          <li aria-current="page">{suburb} ({postcode})</li>
        </ol>
      </nav>

      <!-- Main Header -->
      <header class="landing-header">
        <h1>{h1}</h1>
        <p class="license-subtitle">Local Western Suburbs Electrician · Energy Safe Victoria Registered {business.recNumber}</p>
      </header>

      <!-- Answer-First Summary -->
      <AnswerFirst text={answerFirst} badge={`Local Service: ${suburb}`} />

      <!-- Suburb Profile Strip -->
      <div class="suburb-profile-grid">
        <div class="profile-item">
          <span class="profile-label">SUBURB & POSTCODE</span>
          <span class="profile-value">{suburb}, VIC {postcode}</span>
        </div>
        <div class="profile-item">
          <span class="profile-label">TYPICAL HOUSING STOCK</span>
          <span class="profile-value">{housingEra}</span>
        </div>
        <div class="profile-item">
          <span class="profile-label">DISPATCH DEPOT</span>
          <span class="profile-value">Burnside / Caroline Springs Corridor</span>
        </div>
        <div class="profile-item">
          <span class="profile-label">LICENSED CONTRACTOR</span>
          <span class="profile-value">Nick (REC 29064)</span>
        </div>
      </div>

      <!-- Main Body Content -->
      <div class="landing-content">
        <slot />

        {typicalIssues && typicalIssues.length > 0 && (
          <section class="local-issues-section">
            <h2>Common Electrical Work in {suburb}</h2>
            <ul class="issues-list">
              {typicalIssues.map((issue) => (
                <li>{issue}</li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <!-- Author Verification -->
      <AuthorCredit lastReviewed={lastReviewed} />

      <!-- FAQs -->
      {faqs && faqs.length > 0 && (
        <FaqBlock faqs={faqs} title={`Frequently Asked Questions in ${suburb}`} />
      )}

      <!-- Quote CTA -->
      <div class="cta-form-section">
        <QuoteForm 
          title={`Book an Electrician in ${suburb}`} 
          subtitle={`Local fast response across ${suburb} and surrounding western estates`} 
        />
      </div>

    </div>
  </article>
</BaseLayout>

<style>
  .landing-page {
    padding: 3rem 1.5rem 5rem 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    color: #e0e0e0;
  }
  .breadcrumb-nav ol {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    font-size: 0.88rem;
    color: #888;
    gap: 0.5rem;
    align-items: center;
  }
  .breadcrumb-nav a {
    color: #aaa;
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: var(--accent, #f5a623);
  }
  .breadcrumb-nav [aria-current="page"] {
    color: var(--accent, #f5a623);
  }
  .landing-header h1 {
    font-size: 2.3rem;
    line-height: 1.25;
    margin-bottom: 0.5rem;
    color: #fff;
    font-family: 'Cinzel', serif;
  }
  .license-subtitle {
    font-size: 0.95rem;
    color: #888;
    margin-bottom: 1.5rem;
  }
  .suburb-profile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2.5rem 0;
  }
  .profile-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .profile-label {
    font-size: 0.72rem;
    color: #888;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .profile-value {
    font-size: 0.95rem;
    color: #fff;
    font-weight: 600;
  }
  .landing-content :global(h2) {
    font-size: 1.6rem;
    color: #fff;
    margin: 2.5rem 0 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.5rem;
  }
  .landing-content :global(p) {
    line-height: 1.7;
    margin-bottom: 1.2rem;
    font-size: 1.02rem;
  }
  .issues-list {
    padding-left: 1.4rem;
    margin-bottom: 2rem;
  }
  .issues-list li {
    margin-bottom: 0.6rem;
    line-height: 1.6;
  }
  .cta-form-section {
    margin-top: 4rem;
  }
</style>
